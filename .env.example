# Phoenix — Environment Variables Example
# Copy this file to .env.local (per app, or at the repo root if shared) and
# fill in real values. Do not commit .env.local or any file containing
# secrets.

# Public site URL, used for metadataBase, sitemap generation, and Open Graph
# tags. Set to the staging URL in staging environments.
NEXT_PUBLIC_SITE_URL=https://phoenixops.ai

# Public contact email surfaced in site copy and mailto links.
NEXT_PUBLIC_CONTACT_EMAIL=hello@phoenixops.ai

# ------------------------------------------------------------
# Phoenix Platform — API runtime mode
# (PHX-PLATFORM-009 mock/real-disabled, PHX-LIVE-001 real-dev,
#  PHX-PLATFORM-010 production-auth / Clerk)
# ------------------------------------------------------------
# These configure apps/platform's api-config.ts mode boundary. See
# apps/platform/.env.example for the full, authoritative variable list
# (backend URL, dev header vars, Clerk vars) — the values below are a
# minimal root-level mirror for convenience only.

# 'mock' (default), 'real-dev', 'real-disabled', or 'production-auth'
# (alias: 'clerk-auth'). Anything unrecognized resolves to 'mock'.
NEXT_PUBLIC_PHOENIX_API_MODE=mock

# Backend base URL. Required for real-dev and production-auth; unused in mock.
NEXT_PUBLIC_PHOENIX_BACKEND_URL=

# Forward-compatibility flag only — retained for older tooling; does not
# itself change resolved mode (see api-config.ts's resolveApiMode()).
NEXT_PUBLIC_PHOENIX_REAL_API_ENABLED=false

# ------------------------------------------------------------
# Phoenix Website — Public Intake (PHX-LAUNCH-001, Private Beta)
# ------------------------------------------------------------
# See apps/website/db/migrations/0001_public_intake_schema.sql and
# PHX-LAUNCH-001-VERCEL-SETUP-GUIDE.md for the full setup procedure.
# NONE of the values below are real — this file must never contain
# an actual secret.

# NEXT_PUBLIC_TURNSTILE_SITE_KEY — Cloudflare Turnstile site key (public, safe for the browser).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Server-only secrets below. Never prefix these with NEXT_PUBLIC_. ---

# Postgres connection string for the public intake schema (Supabase Postgres in production,
# a local/isolated PostgreSQL instance for development — see the migration file's own notes).
INTAKE_DATABASE_URL=

# Server-only PEM contents of the trusted Supabase root CA.
# Use the certificate downloaded from Supabase Database SSL settings.
# Multiline PEM and literal \\n-delimited forms are both accepted.
INTAKE_DATABASE_CA_CERT=

# Long, random secret used to HMAC-hash IPs, idempotency keys, and upload tokens before storage.
# Rotating this invalidates all outstanding upload tokens and resets rate-limit history.
INTAKE_HASH_SECRET=

# Cloudflare Turnstile secret key (server-side verification only).
TURNSTILE_SECRET_KEY=

# R4: comma-separated exact hostnames the Siteverify response's own
# `hostname` field must match (the domain the Turnstile widget was
# actually rendered on, as Cloudflare observed it). Required before
# Private Beta Go (see the R4 setup guide) -- skipped (not enforced)
# when unset, so this is safe to leave blank in any environment that
# hasn't configured production/preview Turnstile widgets yet.
#   TURNSTILE_ALLOWED_HOSTNAMES=phoenixops.ai,phoenix-preview-abc.vercel.app
TURNSTILE_ALLOWED_HOSTNAMES=

# R4: the exact `action` value the client widget is expected to have
# supplied (see IntakeForm.tsx's turnstile.render() call), checked
# against the Siteverify response's own `action` field. Defaults to
# "public-intake" if unset -- only actually enforced once either this
# variable or the response itself carries an action value.
TURNSTILE_EXPECTED_ACTION=

# Resend API key (transactional email).
RESEND_API_KEY=
INTAKE_FROM_EMAIL=hello@phoenixops.ai
INTAKE_INTERNAL_TO_EMAIL=hello@phoenixops.ai

# Supabase project URL + service-role key (server-only; never exposed to the browser)
# and the private Storage bucket name used for invitation-only uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_INTAKE_BUCKET=private-intake-uploads

# Sentry DSN for error monitoring. Optional — the monitoring adapter is a documented
# no-op when unset, so the intake system still runs safely without it.
SENTRY_DSN=

# Shared secret required by the two internal-only ops routes
# (/api/intake/:id/finalize and /api/intake/:id/upload-session).
# Only the operations CLI (apps/website/scripts/ops/intake-ops.ts) should ever send this header.
INTAKE_OPS_SECRET=

# R3: comma-separated list of EXACT preview origins allowed to submit
# to the public intake/upload routes, in addition to NEXT_PUBLIC_SITE_URL
# itself. There is no wildcard match against arbitrary *.vercel.app
# preview URLs anymore -- list this project's specific preview
# deployment origin(s) explicitly, e.g.:
#   ALLOWED_PREVIEW_ORIGINS=https://phoenix-website-git-staging-yourteam.vercel.app
# A malformed entry is dropped (fails closed), never partially matched.
ALLOWED_PREVIEW_ORIGINS=
