# Phoenix Backend — Environment Variables Example
# PHX-DEPLOY-001 — Local Preview Packaging & Deployment Readiness
#
# Copy to apps/backend/.env and fill in real values for your machine. Do not
# commit .env. The values below are local dev-only defaults — they match
# apps/backend/docker-compose.yml and are safe to keep as-is for a first
# local preview run.
#
# The backend boots fine with NONE of these set (see PHX-BACKEND-001) — it
# falls back to database-disabled, port 4000. Setting them enables the full
# local preview (real database reads/writes, dev CORS for the platform).

# PostgreSQL connection string. Matches docker-compose.yml's phoenix/
# phoenix_dev_password/phoenix_dev defaults. Not required for the backend to
# boot — only for database-backed endpoints to work.
DATABASE_URL=postgresql://phoenix:phoenix_dev_password@localhost:5432/phoenix_dev

# Explicit opt-in flag. Both this AND DATABASE_URL must be set for database
# access to actually be used — defense against accidentally enabling a
# database connection from a stray env var.
PHOENIX_ENABLE_DATABASE=true

# Port the backend HTTP server listens on.
PORT=4000

# ------------------------------------------------------------
# Production CORS allowlist (PHX-DEPLOY-003 — Hosted Preview Blocker
# Resolution, Blocker B2)
# ------------------------------------------------------------
# server.ts registers middleware/cors.ts's productionCorsMiddleware
# unconditionally, in every NODE_ENV. It is safe to leave this unset for
# pure local development (no CORS headers are set for any origin — same
# as before this middleware existed); set it explicitly before any
# hosted/private-preview deployment.
#
# Comma-separated list of exact browser origins to allow. NEVER a
# wildcard — a literal "*" entry here is ignored, not honored, by
# src/middleware/cors.ts. Example for a hosted private preview:
#   PHOENIX_ALLOWED_ORIGINS=https://preview.phoenixops.ai
# Example for local development against a locally-run platform:
#   PHOENIX_ALLOWED_ORIGINS=http://localhost:3001
PHOENIX_ALLOWED_ORIGINS=

# ------------------------------------------------------------
# Legacy dev-only CORS (PHX-LIVE-001) — NOT wired into server.ts as of
# PHX-DEPLOY-003. Retained in src/middleware/dev-cors.ts for reference /
# a possible future local-dev convenience script only. Prefer
# PHOENIX_ALLOWED_ORIGINS above for anything hosted.
# ------------------------------------------------------------
# PHOENIX_ENABLE_DEV_CORS=true
# PHOENIX_DEV_ALLOWED_ORIGIN=http://localhost:3001

# ------------------------------------------------------------
# Auth mode (PHX-BACKEND-009 — Production Auth Preparation)
# ------------------------------------------------------------
# Controls how (or whether) this backend resolves a request actor.
# Allowed values:
#
#   dev-header           Trusts the x-phoenix-user-id header (see
#                         src/auth/request-actor.ts). LOCAL/DEV ONLY —
#                         this is not authentication, it is a
#                         caller-supplied claim with no verification of
#                         any kind. Default outside production.
#
#   production-disabled  No actor can ever be resolved; every protected
#                         endpoint returns 401 AUTH_NOT_CONFIGURED. Safe
#                         fail-closed default for NODE_ENV=production
#                         until a real auth provider is implemented.
#
#   token-placeholder     A non-functional seam for a future bearer
#                         token / OAuth / JWT verifier. Never verifies,
#                         decodes, or trusts a token — every protected
#                         endpoint returns 501 AUTH_NOT_IMPLEMENTED.
#
#   oidc-jwt              PHX-AUTH-002: real production auth. Verifies
#                         a bearer token against the configured
#                         provider's JWKS endpoint. Requires
#                         PHOENIX_AUTH_ISSUER / _AUDIENCE / _JWKS_URI /
#                         _PROVIDER to be ALL set (see below) for the
#                         mode to actually be usable — but explicitly
#                         setting PHOENIX_AUTH_MODE=oidc-jwt ALWAYS
#                         resolves to oidc-jwt, even when that config is
#                         incomplete (PHX-AUTH-002-R1 fix). A misconfigured
#                         oidc-jwt NEVER falls back to dev-header or any
#                         other mode: /api/readiness reports
#                         auth.status="misconfigured", and every protected
#                         route returns 401 AUTH_NOT_CONFIGURED — the
#                         dev-only x-phoenix-user-id header is never
#                         honored in this mode, configured or not. See
#                         src/config/env.ts's resolveAuthMode() /
#                         isOidcConfigured() and
#                         docs/auth/PHX_AUTH_002_R1_IMPLEMENTATION_REPORT.md
#                         for the full before/after.
#
# If PHOENIX_AUTH_MODE is left UNSET (not the same as setting it to
# "oidc-jwt" with incomplete config — see above): NODE_ENV=production
# resolves to production-disabled; anything else resolves to dev-header
# (no behavior change for existing local preview / test setups that
# never set this var).
#
# NODE_ENV=production with PHOENIX_AUTH_MODE=dev-header is refused at
# startup (the process exits immediately with an error) — see
# src/config/env.ts's assertAuthModeSafeToBoot() and
# docs/backend/PHX_BACKEND_009_IMPLEMENTATION_REPORT.md § Production
# guard. Do not attempt to work around this by unsetting NODE_ENV.
PHOENIX_AUTH_MODE=dev-header

# Escape hatch for the startup guard above — an intentionally alarming
# name. Setting this true is the ONLY way to boot with
# NODE_ENV=production and PHOENIX_AUTH_MODE=dev-header at the same
# time. This is NOT a supported production configuration; it exists
# only for a deliberate, reviewed exception (e.g. a short-lived staging
# box). NEVER set this true in a real production deployment.
# PHOENIX_DANGEROUSLY_ALLOW_DEV_HEADER_IN_PRODUCTION=true

# ------------------------------------------------------------
# Hosted auth / OIDC-JWT config (PHX-AUTH-002 — Hosted Auth Vendor
# Decision & Production Resolver)
# ------------------------------------------------------------
# Required for PHOENIX_AUTH_MODE=oidc-jwt to be usable. If ANY of the
# four required vars below is missing while PHOENIX_AUTH_MODE=oidc-jwt
# is explicitly set, the mode stays oidc-jwt — it does NOT fall back to
# production-disabled, dev-header, or any other mode. /api/readiness
# reports auth.status="misconfigured" and every protected route returns
# 401 AUTH_NOT_CONFIGURED until all four vars are set. See
# src/config/env.ts's isOidcConfigured() and
# docs/auth/PHX_AUTH_002_R1_IMPLEMENTATION_REPORT.md.
#
# Selected MVP provider: Clerk (see
# docs/auth/ADR_PHX_AUTH_002_VENDOR_DECISION.md). These values are
# provider-agnostic in shape — any standard OIDC/JWT provider works as
# long as it publishes a JWKS endpoint.

# Required. Your provider's issuer URL — checked as an exact allowlist
# match against the token's `iss` claim (never a substring/prefix check).
PHOENIX_AUTH_ISSUER=

# Required. Your provider's registered audience/client id — checked as
# an exact match against the token's `aud` claim.
PHOENIX_AUTH_AUDIENCE=

# Required. Your provider's published JWKS endpoint — fetched and
# cached (with rotation handling) to verify token signatures. Never a
# secret itself, but not typically exposed further than server-side
# config.
PHOENIX_AUTH_JWKS_URI=

# Required. A short identifier for which provider is configured (e.g.
# "clerk"). Recorded on auth_identities rows and surfaced (only this
# value, nothing else) in /api/readiness's auth.provider field.
PHOENIX_AUTH_PROVIDER=clerk

# Optional. Claim names to read for email / email-verified / display
# name, in case your provider uses non-default claim names. Defaults
# shown below match every major OIDC provider's standard claims.
# PHOENIX_AUTH_EMAIL_CLAIM=email
# PHOENIX_AUTH_EMAIL_VERIFIED_CLAIM=email_verified
# PHOENIX_AUTH_DISPLAY_NAME_CLAIM=name

# Optional. Clock-skew tolerance (seconds) for expiry/iat checks.
# Default: 60.
# PHOENIX_AUTH_CLOCK_SKEW_SECONDS=60

# To exercise oidc-jwt locally without a real provider account, run:
#   node scripts/auth-test-jwks.mjs
# and set PHOENIX_AUTH_ISSUER / PHOENIX_AUTH_AUDIENCE /
# PHOENIX_AUTH_JWKS_URI / PHOENIX_AUTH_PROVIDER to the values it prints,
# then set PHOENIX_AUTH_MODE=oidc-jwt above. Mint a matching test token
# with scripts/auth-test-token.mjs. See
# docs/auth/PHX_AUTH_002_AUTH_QA_REPORT.md for the full local QA flow.

# ------------------------------------------------------------
# Private Beta intake service boundary (PHX-LAUNCH-002-R2)
# ------------------------------------------------------------
# Backend-to-Website service configuration for protected operator
# intake operations. These values are optional at boot and are resolved
# fail-closed by the R2 route/service layer when absent.
#
# Fixed Website origin/base URL. Use HTTPS for hosted environments.
PHOENIX_INTAKE_SERVICE_BASE_URL=
#
# Dedicated Backend-to-Website credential. It must match the Website
# INTAKE_SERVICE_SECRET value. Never reuse INTAKE_OPS_SECRET.
PHOENIX_INTAKE_SERVICE_SECRET=
#
# Optional outbound request timeout in milliseconds. Valid range:
# 1..30000. Missing or invalid values default to 5000.
# PHOENIX_INTAKE_SERVICE_TIMEOUT_MS=5000

# ------------------------------------------------------------
# Report generation & artifact storage (PHX-REPORTS-004 — Report
# Generation Lifecycle & Secure Artifact Delivery Foundation)
# ------------------------------------------------------------
# All of the below have safe defaults (shown as comments) — the backend
# and worker both boot fine with none of these set. Local filesystem
# storage only; cloud object storage is out of scope for this sprint.
# Generated files under REPORT_STORAGE_LOCAL_DIR are NEVER committed to
# Git (see root .gitignore).

# Local artifact storage directory (relative to apps/backend, or an
# absolute path). The deterministic key itself already begins with
# "reports/", so this directory is the STORAGE ROOT, not a
# reports-specific subfolder. Default: ./storage
# REPORT_STORAGE_LOCAL_DIR=./storage

# Byte-size cap enforced before an artifact is written or read. A
# renderer whose output exceeds this fails generation rather than being
# silently truncated. Default: 26214400 (25MB)
# REPORT_MAX_ARTIFACT_BYTES=26214400

# Retention window (seconds): an Available report's expires_at is set to
# generatedAt + this many seconds. Default: 604800 (7 days)
# REPORT_RETENTION_SECONDS=604800

# Continuous worker poll interval (seconds). Default: 5
# REPORT_WORKER_POLL_INTERVAL_SECONDS=5

# A Processing job whose locked_at is older than this is treated as
# abandoned by the lease-reclaim sweep. Default: 120
# REPORT_WORKER_LEASE_SECONDS=120

# How often a worker actively holding a job refreshes locked_at while
# rendering. MUST be strictly less than REPORT_WORKER_LEASE_SECONDS —
# validated at worker/server startup by
# config/report-worker-env.ts's assertReportWorkerConfigSafe(); an
# unsafe value refuses to boot. Default: 30
# REPORT_WORKER_HEARTBEAT_SECONDS=30

# A file with no report_artifacts row and no valid Processing lease is
# eligible for reconciliation-delete only once older than this. MUST be
# strictly greater than REPORT_WORKER_LEASE_SECONDS (validated at boot,
# same as above) — otherwise reconciliation could race a still-alive
# worker's in-flight generation attempt. Default: 300
# REPORT_ARTIFACT_RECONCILIATION_GRACE_SECONDS=300

# Maximum generation attempts before a job/report is marked terminally
# Failed. MUST be >= 1 (validated at boot). Default: 3
# REPORT_WORKER_MAX_ATTEMPTS=3

# Bounded linear backoff base (seconds) — requeue delay is
# attempt_count * this value. MUST be > 0 (validated at boot).
# Default: 10
# REPORT_WORKER_BACKOFF_BASE_SECONDS=10

# Hard cap on assets considered by the workspace-portfolio-summary
# template. A workspace whose real asset count exceeds this fails
# generation closed with a clear reason, rather than silently truncating
# what could be misread as a complete portfolio. Default: 500
# REPORT_PORTFOLIO_MAX_ASSETS=500
