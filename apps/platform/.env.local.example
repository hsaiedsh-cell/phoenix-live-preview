# Phoenix Platform — Environment Variables Example
# PHX-PLATFORM-009 (mock/real-disabled) — PHX-LIVE-001 (real-dev) —
# PHX-PLATFORM-010 (production-auth / Clerk) — PHX-DEPLOY-004C
# (vercel-supabase-preview / Clerk + Supabase, no separate backend host)
#
# Copy to apps/platform/.env.local and fill in real values. Do not commit
# .env.local or any file containing secrets (CLERK_SECRET_KEY).

# ------------------------------------------------------------
# API runtime mode
# ------------------------------------------------------------
# One of: mock | real-dev | real-disabled | production-auth | vercel-supabase-preview
# (alias for production-auth: clerk-auth)
#
#   mock             Default. No env vars required. Always works.
#   real-dev         Calls the real backend using the development-only
#                    X-Phoenix-User-Id header. NOT authentication — do
#                    not use outside local/trusted preview. Requires
#                    NEXT_PUBLIC_PHOENIX_BACKEND_URL and
#                    NEXT_PUBLIC_PHOENIX_DEV_USER_ID.
#   real-disabled    Real backend requested but disabled. Preserved from
#                    PHX-PLATFORM-009.
#   production-auth  Clerk-backed hosted auth. Requires
#                    NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY,
#                    and NEXT_PUBLIC_PHOENIX_BACKEND_URL. Sends
#                    Authorization: Bearer <token> to the backend, never
#                    X-Phoenix-User-Id. Missing config fails closed — it
#                    does NOT fall back to mock or real-dev.
#   vercel-supabase-preview  PHX-DEPLOY-004C. Clerk-backed, but reads
#                    Supabase/Postgres DIRECTLY server-side — no separate
#                    Express backend host, no NEXT_PUBLIC_PHOENIX_BACKEND_URL
#                    needed. Requires NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY,
#                    CLERK_SECRET_KEY, PHOENIX_DATABASE_URL, and
#                    NEXT_PUBLIC_PHOENIX_PRODUCTION_WORKSPACE_ID. Missing
#                    config fails closed — never falls back to mock.
NEXT_PUBLIC_PHOENIX_API_MODE=mock

# Backend base URL, e.g. http://localhost:4000. Required for real-dev and
# production-auth; unused in mock/real-disabled.
NEXT_PUBLIC_PHOENIX_BACKEND_URL=

# ------------------------------------------------------------
# real-dev only (PHX-LIVE-001) — dev header, no auth of any kind
# ------------------------------------------------------------
# Seed user id (Owner/Admin/Reviewer/Contributor/Viewer/Auditor) sent as
# X-Phoenix-User-Id. Required for real-dev.
NEXT_PUBLIC_PHOENIX_DEV_USER_ID=

# Seed workspace id, used for real-dev context bootstrap. Optional.
NEXT_PUBLIC_PHOENIX_DEV_WORKSPACE_ID=

# ------------------------------------------------------------
# production-auth only (PHX-PLATFORM-010) — Clerk
# ------------------------------------------------------------
# Selected MVP hosted auth provider: Clerk (see PHX-AUTH-002 vendor ADR).
# Publishable key — safe to expose client-side (NEXT_PUBLIC_*).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Secret key — SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_. Never
# commit a real value. Read by @clerk/nextjs/server, not by any file in
# lib/api-config.ts or lib/auth/platform-auth.client.ts.
CLERK_SECRET_KEY=

# Sign-in only in this release — sign-up is intentionally not exposed via
# the platform's own /login page (see app/login/page.tsx,
# ClerkSignInPanel.tsx). These URLs point Clerk's own redirects at
# Phoenix's routes; signUpUrl is set to /login (not a separate flow).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Interim, explicitly temporary (PHX-PLATFORM-011): which workspace
# production-auth reads should be scoped to. The backend has no
# "workspaces for the authenticated identity" endpoint yet (that is
# PHX-AUTH-001 future work) — until it does, this is the only way
# production-auth mode knows which workspace to query for the
# dashboard/assessments/activity/audit live reads. Leaving this unset
# means every migrated live section on this deployment shows a
# "workspace not resolved" config-missing-shaped state instead of
# guessing or falling back to mock data.
NEXT_PUBLIC_PHOENIX_PRODUCTION_WORKSPACE_ID=

# ------------------------------------------------------------
# vercel-supabase-preview only (PHX-DEPLOY-004C) — Vercel + Supabase
# ------------------------------------------------------------
# Server-only Supabase/Postgres connection string. NEVER prefix with
# NEXT_PUBLIC_. Never commit a real value. Deliberately named
# PHOENIX_DATABASE_URL (not DATABASE_URL) so this app never accidentally
# picks up an unrelated DATABASE_URL a hosting integration may inject.
# Read only by lib/db/preview-db.server.ts and
# lib/auth/preview-auth.server.ts (presence-only check) — never by
# api-config.ts, and never sent to the client.
PHOENIX_DATABASE_URL=

# Reuses the same interim workspace-scope bridge production-auth uses
# (see that section above) — vercel-supabase-preview has no
# "workspaces for the authenticated identity" query either. Required.
NEXT_PUBLIC_PHOENIX_PRODUCTION_WORKSPACE_ID=

# ------------------------------------------------------------
# Legacy / forward-compatibility (PHX-PLATFORM-009)
# ------------------------------------------------------------
# No longer changes resolved behavior — kept only so an older .env.local
# copied forward does not produce an unrecognized-var warning in tooling
# that lints env files.
NEXT_PUBLIC_PHOENIX_REAL_API_ENABLED=false
NEXT_PUBLIC_PHOENIX_API_BASE_URL=
