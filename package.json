{
  "name": "phoenix-monorepo",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "dev": "pnpm --filter @phoenix/website dev",
    "build": "pnpm --filter=./apps/* build",
    "lint": "pnpm --filter=./apps/* lint",
    "type-check": "pnpm --filter=./apps/* type-check"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.18",
      "brace-expansion@1": "5.0.8",
      "brace-expansion@2": "5.0.8",
      "next@15.5.21>sharp": "0.35.3"
    }
  }
}
